# Google Apps Script Web App deployment URL ending in /exec
VITE_SHEETS_URL=

# Optional: set true to fetch names from Apps Script doGet.
# If the request fails, the local list in src/data/guestList.js is used.
VITE_USE_LIVE_GUEST_LIST=false

# Optional: set true if you want the opening invitation to appear on every reload.
# Default behavior shows it once per browser session.
VITE_ENTRY_GATE_EVERY_VISIT=false
